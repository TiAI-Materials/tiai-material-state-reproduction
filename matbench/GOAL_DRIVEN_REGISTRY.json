  "mission": "Measure the frontier of verified agent replacement from bounded tasks to roles, teams, organizations and industry systems, while preserving explicit human-in-the-loop, verification, recovery, budget and safety boundaries.",
  "principles": [
    "Define a goal and executable criteria before execution.",
    "The worker may propose completion, but only an independent verifier may close the goal.",
    "If criteria are unmet, the system must continue, restart, replan or truthfully exhaust its budget.",
    "Human-in-the-loop dependence is measured rather than hidden.",
    "Locally verifiable work is separated from simulation, digital-twin, physical and socio-regulatory work.",
    "Using an existing tool and reconstructing a compatible tool are distinct benchmark tracks.",
    "Results are reported by task, workflow, role, team, organization and industry scope.",
    "Materials multiscale work is the first active scientific vertical, not the boundary of the benchmark."
  ],
  "replacement_scopes": [
    "TASK",
    "WORKFLOW",
    "ROLE",
    "TEAM",
    "ORGANIZATION",
    "INDUSTRY"
  ],
  "schema": "tiai.agentbench.goal_driven_registry.v1",
  "verifiability_levels": [
    {
      "definition": "Work can be executed and exhaustively or differentially checked on local compute, such as mathematics, compilers, parsers and deterministic software kernels.",
      "id": "V0_LOCAL_DETERMINISTIC"
    },
    {
      "definition": "Work is checked through scientific computation, frozen replay or bounded external solvers, such as DFT, CAE, EDA, ML training and multiscale simulation.",
      "id": "V1_COMPUTE_OR_REPLAY"
    },
    {
      "definition": "Work is verified in a stateful simulator or digital twin with trajectory and fault checks before physical deployment.",
      "id": "V2_DIGITAL_TWIN"
    },
    {
      "definition": "Work changes or measures the physical world and requires instrument, specimen, robot, calibration and safety receipts.",
      "id": "V3_PHYSICAL_INSTRUMENT"
    },
    {
      "definition": "Work depends materially on human judgment, consent, negotiation, law, policy, ethics or organizational authority and cannot be fully machine-certified.",
      "id": "V4_SOCIO_REGULATORY"
    }
  ],
  "version": "0.4.0-goal-driven"
}
